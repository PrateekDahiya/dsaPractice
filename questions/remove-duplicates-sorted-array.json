  "problemStatement": "Given a sorted integer array <code>nums</code>, remove the duplicates <strong>in-place</strong> so that each unique element appears only once. Return <code>k</code>, the number of unique elements. The first <code>k</code> positions of <code>nums</code> must contain the unique elements in sorted order.",
  "constraints": [
    "1 <= nums.length <= 10^5",
    "-100 <= nums[i] <= 100",
    "nums is sorted in non-decreasing order"
  ],
  "examples": [
    {
      "input": "nums = [1,1,2]",
      "output": "2, nums = [1,2,2]",
      "explanation": "There are two unique elements, 1 and 2. The first two positions of nums should contain [1,2]."
    },
    {
      "input": "nums = [0,0,1,1,1,2,2,3,3,4]",
      "output": "5, nums = [0,1,2,3,4,2,2,3,3,4]",
      "explanation": "There are five unique elements: 0, 1, 2, 3, and 4."
    },
    {
      "input": "nums = [1,2,3,4]",
      "output": "4, nums = [1,2,3,4]",
      "explanation": "All elements are already unique."
    }
